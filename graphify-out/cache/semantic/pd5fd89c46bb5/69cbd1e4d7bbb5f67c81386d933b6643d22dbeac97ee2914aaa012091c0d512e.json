{"nodes": [{"id": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver", "label": "Coin-HSL Linear Solver Integration - Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver_consumer_before_producer_ordering", "label": "Task ordering: rewrite consumer before producer", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_make_solver must learn to pop the top-level _hsl_dir key before userOpts starts emitting it; otherwise CasADi would reject the unknown option and every solve would break. Hence Task 2 (consumer) precedes Task 3 (producer)."}, {"id": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver_known_limitation_init_solver_not_forwarded", "label": "Known limitation: linear_solver not forwarded to warm-start", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MLTP did not forward linear_solver/hsl_dir into its internal MLTP_initial warm-start call, so the 7-state init used the userOpts default (ma57); only an explicit non-default solver failed to propagate. Declared out of scope."}, {"id": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver_probe_success_criterion", "label": "Probe success criterion", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A trivial NLP solve must return return_status == 'Solve_Succeeded'; a failed HSL load returns 'Invalid_Option' (verified empirically), which the probe treats as failure and falls back to MUMPS."}, {"id": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver_solve_stats_hook", "label": "ctx.solve_stats / ctx.elapsed hook", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MLTP previously discarded the solver object; the benchmark needs iter_count, return_status and per-callback wall times from solver.stats(), so MLTP stashes ctx.solve_stats and ctx.elapsed={'init','solve'}."}], "edges": [{"source": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver", "target": "docs_superpowers_specs_2026_06_23_coin_hsl_linear_solver_design", "relation": "cites", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver", "target": "functions_transcription_make_solver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver", "target": "functions_transcription_build_and_solve_nlp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_06_23_coin_hsl_linear_solver", "target": "functions_hsl_resolve_hsl_dir", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-23-coin-hsl-linear-solver.md", "source_location": null, "weight": 1.0}