ile": "docs/superpowers/specs/2026-06-24-windows-app-gui-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_24_windows_app_gui_design", "target": "claude_wheel_radius_gear_quirk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-24-windows-app-gui-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_24_windows_app_gui_design", "target": "claude_synthetic_circuits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-24-windows-app-gui-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_24_windows_app_gui_design", "target": "claude_casadi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-24-windows-app-gui-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_24_windows_app_gui_design", "target": "claude_ipopt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-24-windows-app-gui-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_24_windows_app_gui_design", "target": "claude_mumps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-24-windows-app-gui-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_24_windows_app_gui_design", "target": "claude_coin_hsl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-24-windows-app-gui-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_24_windows_app_gui_design", "target": "claude_pa